# Real secrets — never commit. See keystore-credentials.txt's own header
# comment for what's at stake if this leaks or is lost.
android-keystore
keystore-credentials.txt
*.jks
*.keystore

# Play Developer API service-account key (upload-release.mjs) — whoever
# holds this file can publish releases to the real Play Console listing.
# Never committed; path is passed in via GOOGLE_APPLICATION_CREDENTIALS,
# not a fixed name, but these cover the conventional ones people save it
# as if they don't set that env var explicitly.
service-account*.json
play-*.json
*-service-account.json

# Tooling used only to generate this project (generate-project.mjs),
# not part of the Android build itself.
node_modules/
package-lock.json

# Standard Android/Gradle build output.
.gradle/
app/build/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
