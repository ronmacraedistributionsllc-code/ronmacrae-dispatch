# Dependencies
node_modules/

# Builds
dist/
build/
*.tsbuildinfo

# Environment - NEVER commit real credentials
.env
.env.*
!.env.example

# Android signing / Firebase secrets - NEVER commit (hard rule R1)
*.jks
*.keystore
**/google-services.json
**/keystore-credentials.txt
**/*-service-account*.json

# Databases
*.db
*.db-journal
*.db.bak*
dev.db
.dev/

# Uploads / media
apps/api/data/uploads/
apps/api/data/*.db

# Logs
logs/
*.log
npm-debug.log*

# Test artifacts
coverage/
playwright-report/
test-results/
apps/web/dev-dist/
apps/web/dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Prisma generated (regenerated per provider)
apps/api/prisma/schema.generated.prisma

# Capacitor native shell (not a workspace; generated output only — the
# android/ project sources stay tracked)
native/node_modules/
native/dist/
native/android/.gradle/
native/android/app/build/
native/android/build/
native/android/capacitor-cordova-android-plugins/build/
native/android/local.properties
native/android/*.iml
native/android/.idea/
# Regenerated by `npx cap sync` from native/package.json + native/www
native/android/app/src/main/assets/
native/android/capacitor-cordova-android-plugins/
