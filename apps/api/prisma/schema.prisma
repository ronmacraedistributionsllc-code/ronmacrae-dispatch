// Canonical schema. The datasource provider is templated by scripts/prepare-db.mjs:
//   - postgresql for production (DigitalOcean managed)
//   - sqlite     for zero-service local preview / CI
// All field types are portable across both providers (no pg-specific @db.*).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & identity ----------

enum Role {
  admin
  dispatcher
  accountant
  viewer
  rider
}

/** Platform-level authority, separate from any single business's staff role.
 *  A platform owner oversees every business on the network; they are not
 *  necessarily an admin (or even a member) of any one of them. */
enum PlatformRole {
  owner
}

/** One participating store on the network. Every business-owned resource
 *  (jobs, customers, zones, offers...) carries a businessId; a business
 *  admin/dispatcher/accountant/viewer only ever sees their own business's
 *  data. Settings that used to live in the old global `Setting("business")`
 *  singleton now live directly on this row, per business. */
model Business {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String?  @unique
  active               Boolean  @default(true)
  dispatchPhone        String?
  dispatchWhatsApp     String?
  /** Where the "a new order came in" alert goes — separate from any
   *  merchant's own notificationEmails (merchant-notify.ts): this fires for
   *  every order, merchant-linked or not, so dispatch never has to refresh
   *  the Jobs screen to notice new work. */
  dispatchNotificationEmail String?
  operationalCurrency  String   @default("JMD")
  usdToJmdRate         Float?
  defaultZoneId        String?
  pinLength            Int      @default(4)
  trackingLinkTtlHours Float    @default(72)
  nativeAppRecommended Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  staffMemberships StaffMembership[]
  riderMemberships RiderMembership[]
  jobs             Job[]
  customers        Customer[]
  zones            Zone[]
  offers           JobOffer[]
  merchants        Merchant[]
  logisticsCompanies LogisticsCompany[]
  settlements      Settlement[]
}

/** A staff member's role at one specific business. A User is the global
 *  identity (one login); their access at each business they work with is a
 *  separate StaffMembership row, so the same person can be a dispatcher at
 *  one business and, say, a viewer at another. */
model StaffMembership {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, businessId])
  @@index([businessId, role])
}

/** Whether a rider is allowed on the open network at all — a platform-owner
 *  controlled gate, independent of which specific businesses they're a
 *  member of (see RiderMembership below). */
enum PlatformRiderStatus {
  pending
  approved
  suspended
}

enum RiderMembershipStatus {
  pending
  active
  suspended
  removed
}

/** Whether a rider is currently attached to a given merchant (see
 *  MerchantRider below). `active` is the attached state; `removed` is the
 *  soft-removed correction that keeps the relationship's history without
 *  letting it show up in any "my riders" list — same "corrections are new
 *  state, never erased history" rule as RiderMembershipStatus. */
enum MerchantRiderStatus {
  active
  removed
}

/** A rider's relationship with one specific business. A Rider is the global
 *  profile (one login, one location stream, one vehicle); which businesses
 *  they actually carry jobs for is tracked here, and a membership can only
 *  be `active` once the rider also holds platform-level approval. */
model RiderMembership {
  id           String                 @id @default(cuid())
  riderId      String
  rider        Rider                  @relation(fields: [riderId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status       RiderMembershipStatus  @default(pending)
  invitedAt    DateTime               @default(now())
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?                  @relation("riderMembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([riderId, businessId])
  @@index([businessId, status])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  /** Set once this user has proven ownership of `email` via a code (see
   *  CustomerEmailCode, reused generically for this — not customer-only
   *  despite the model's name). Only enforced today for a rider's own
   *  public self-signup (riders.ts) — an admin directly creating a staff
   *  or rider login is itself the vouching, so that path sets this
   *  immediately instead of making them go through a code. */
  emailVerifiedAt DateTime?
  phone        String?  @unique
  passwordHash String
  name         String
  /** Legacy single-business role — kept for the pre-multi-tenancy demo staff
   *  during migration; a user's real, current access at a given business is
   *  their StaffMembership row there. Not read by any business-scoped route
   *  once StaffMembership exists for that user. */
  role         Role     @default(viewer)
  /** Platform-wide authority (the network's own owner/operator), independent
   *  of — and not requiring — membership in any specific business. */
  platformRole PlatformRole?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  /** Distinct from `active` (spec: PENDING/ACTIVE/SUSPENDED/REJECTED/
   *  DELETED are separate states, and "master admin global delete must be
   *  audited" as its own action, not just another disable). Set only by
   *  DELETE /api/platform/users/:id (platform-owner only) — a genuine,
   *  deliberate account-removal decision, always paired with active:false
   *  and its own "platform.user.delete" audit action. Soft: the row and
   *  every historical relation it's referenced from (jobs, ratings,
   *  audit log, settlements...) stay exactly as they are — a courier or
   *  merchant staff member being deleted must never make past order
   *  history disappear or dangle. Login checks this first, with its own
   *  distinct "Account deleted" message, never the generic "disabled"
   *  one a merely-suspended account gets. */
  deletedAt    DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /** Stage E (spec: theme switcher, "persist per user"). Null means the
   *  default theme, same as no value in localStorage — a fresh login on a
   *  brand-new device applies this over whatever that device's own
   *  localStorage already had, so the choice genuinely follows the person,
   *  not just the browser. Free-text (not an enum) so a new theme id never
   *  needs a migration — an unrecognized value is just treated as unset by
   *  the frontend's own THEMES allow-list. */
  theme        String?

  rider     Rider?
  staffMemberships StaffMembership[]
  merchantStaffMemberships MerchantStaff[]
  logisticsCompanyStaffMemberships LogisticsCompanyStaff[]
  invitesSent Invite[]
  riderMembershipApprovals RiderMembership[] @relation("riderMembershipApprover")
  merchantRiderCreations   MerchantRider[]    @relation("merchantRiderCreator")
  merchantApplicationReviews   Merchant[]         @relation("merchantApplicationReviewer")
  logisticsApplicationReviews  LogisticsCompany[] @relation("logisticsApplicationReviewer")
  sessions  Session[]
  audits    AuditLog[]
  payouts   Payout[]           @relation("payoutApprover")
  recon     ReconDaily[]       @relation("reconResolver")
  pushSubscriptions PushSubscription[]
  codApprovals Job[]           @relation("codApprover")
  codArchives  Job[]           @relation("codArchiver")
  addressChangeReviews AddressChangeRequest[] @relation("addressChangeReviewer")
  settlementsReceived Settlement[] @relation("settlementReceiver")
  platformMessages PlatformMessage[] @relation("platformMessageTargetUser")
}

/** One browser/device's opt-in Web Push subscription. A user may have several (multiple devices/browsers). */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  /** The business this login session is scoped to — set once at login (from
   *  the chosen StaffMembership) and carried forward on every refresh, so a
   *  multi-business admin's session doesn't silently jump to a different
   *  business mid-session. Null for a rider or platform-owner session. */
  businessId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------- Bearer (rider) ----------

enum VehicleType {
  motorcycle
  car
}

enum RiderStatus {
  offline
  available
  on_job
  unavailable
}

model Rider {
  id                 String      @id @default(cuid())
  userId             String?     @unique
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name               String
  phone              String      @unique
  vehicle            VehicleType @default(motorcycle)
  plate              String?
  photoUrl           String?
  homeZoneId         String?
  homeZone           Zone?       @relation("riderHomeZone", fields: [homeZoneId], references: [id], onDelete: SetNull)
  basePoint          Json?
  status             RiderStatus @default(offline)
  dailyCapacity      Int         @default(15)
  payRate            Int?
  payCurrency        String      @default("JMD")
  active             Boolean     @default(true)
  /** Platform-wide gate: a membership can only go `active` at any business
   *  once this is `approved`. Owner-controlled, not any one business's call. */
  platformStatus     PlatformRiderStatus @default(pending)
  /** Platform Admin-controlled (see RiderAttachment's doc comment for the
   *  exact eligibility rule this drives in offers.ts). Default `freelance`
   *  leaves every pre-existing rider's behavior unchanged. */
  attachment                  RiderAttachment @default(freelance)
  attachedMerchantId          String?
  attachedMerchant            Merchant?         @relation(fields: [attachedMerchantId], references: [id], onDelete: SetNull)
  attachedLogisticsCompanyId  String?
  attachedLogisticsCompany    LogisticsCompany? @relation(fields: [attachedLogisticsCompanyId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  jobs        Job[]
  assignments RiderAssignment[]
  locations   RiderLocation[]
  routes      Route[]
  recon       ReconDaily[]
  payouts     Payout[]
  alerts      SosAlert[]
  offers      JobOffer[]
  memberships RiderMembership[]
  settlements Settlement[]
  ratings     Rating[]
  platformMessages PlatformMessage[]
  merchantRiders MerchantRider[]
}

// ---------- Geography / pricing ----------

model Zone {
  id         String   @id @default(cuid())
  /** Nullable only during the multi-tenancy migration's backfill window —
   *  every zone belongs to exactly one business once backfilled. */
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  parish     String?
  geometry   Json
  baseFee    Int      @default(0)
  feeCurrency String  @default("JMD")
  perKmFee   Int?
  /** Optional flat surcharge (minor units) added when a job in this zone is marked urgent. */
  urgentSurchargeFee Int?
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customers Customer[] @relation("customerZone")
  jobs      Job[]      @relation("jobZone")
  homeRiders Rider[]   @relation("riderHomeZone")

  @@unique([businessId, slug])
}

model FareRule {
  id         String   @id @default(cuid())
  fromZoneId String
  toZoneId   String
  fee        Int
  currency   String   @default("JMD")
  minFee     Int?
  note       String?
  validFrom  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromZoneId, toZoneId])
}

// ---------- Merchants / catalog ----------

/** A store/client of the courier business (e.g. "VBR Basics") — distinct from
 *  `Business`, which is the courier/dispatch operator itself (Ronmacrae).
 *  Every merchant belongs to exactly one business; a business can have many
 *  merchants. A job with `merchantId: null` is a direct/in-house order (no
 *  third-party store involved) — the pre-existing single-store `/book` flow
 *  and staff-entered orders both still work this way. */
model Merchant {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  logoUrl    String?
  phone      String?
  email      String?
  /** Comma-separated list — kept as one field rather than a child table since
   *  it's small, admin-edited, and never queried independently of the merchant. */
  notificationEmails String?
  pickupAddressText   String?
  pickupPoint          Json?
  /** Freeform text (e.g. "Mon-Sat 9am-6pm") — not parsed/enforced anywhere yet. */
  businessHours String?
  active     Boolean  @default(true)
  /** Distinct from `active` (spec: "Platform Admin can approve/reject/
   *  disable/reactivate... merchant applications" — four separate verbs,
   *  not one boolean). `pending` + `active:false` is a fresh self-signup
   *  awaiting review; `rejected` + `active:false` is a reviewed-and-
   *  declined application (never shown as "just another disabled
   *  merchant" — see `rejectionReason`); `approved` covers both an
   *  approved-then-active merchant and an approved-then-later-disabled
   *  one, same as before this field existed. Defaults `approved` so every
   *  merchant created directly by staff (`POST /api/merchants`, never a
   *  self-signup application) needs no review step, and every merchant
   *  that existed before this field needs no backfill. */
  applicationStatus ApplicationStatus @default(approved)
  /** Set only on a `rejected` decision — shown to nobody but Platform
   *  Admin; the applicant is never told why over email (spec: keep it
   *  reviewable, not automatically re-sent to the applicant). */
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?             @relation("merchantApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]
  jobs     Job[]
  settlements Settlement[]
  staff    MerchantStaff[]
  attachedRiders Rider[]
  merchantRiders MerchantRider[]
  ratings   Rating[]

  @@unique([businessId, slug])
}

/** A merchant's own login — a distinct "face" from staff (StaffMembership)
 *  and rider (RiderMembership), same pattern: its own auth (jwt.ts's
 *  merchant_portal token, merchant-portal.ts), scoped to exactly one
 *  merchant, never a whole Business. Reuses the shared User table (email +
 *  password) rather than a parallel identity table — `User.role` is
 *  irrelevant here (merchant-portal auth never reads it, unlike staff
 *  login's resolveStaffContext), same as it's already irrelevant for a
 *  rider once RiderMembership exists. */
model MerchantStaff {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
}

/**
 * A rider's attachment to one specific merchant — the many-to-many link
 * between a merchant (a store client) and the couriers that deliver its
 * orders. Deliberately separate from (and additive to) two other existing
 * relationships:
 *   - `RiderMembership` links a rider to a `Business` (the courier operator)
 *     and is about which *business* a rider carries jobs for at all.
 *   - `Rider.attachedMerchantId` is the platform-owner's *eligibility* gate
 *     ("attached only to one merchant"), a single-merchant flag that drives
 *     offer eligibility in offers.ts.
 * This model is the merchant-facing roster: one merchant can have many
 * riders, one rider can belong to many merchants, and removing a rider here
 * only removes this one relationship — never the rider's platform account,
 * never another merchant's relationship with that same rider.
 *
 * `@@unique([merchantId, riderId])` is the duplicate-prevention guarantee:
 * a merchant can never be attached to the same rider twice. Re-adding after
 * a removal re-activates the same row rather than inserting a second one.
 */
model MerchantRider {
  id          String              @id @default(cuid())
  merchantId  String
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  riderId     String
  rider       Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  status      MerchantRiderStatus @default(active)
  createdAt   DateTime            @default(now())
  /** Who attached this rider — a merchant-portal login or a platform-owner. */
  createdById String?
  createdBy   User?               @relation("merchantRiderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /** Set when the relationship is `active`; null once removed. */
  approvedAt  DateTime?
  updatedAt   DateTime            @updatedAt

  @@unique([merchantId, riderId])
  @@index([riderId, status])
  @@index([merchantId, status])
}

/** A fleet operator — a business with its own riders who deliver for
 *  merchants (spec: "Bearer/Logistics companies"). Deliberately mirrors
 *  Merchant closely (same child-of-Business shape, same slug/active
 *  pattern) — the real difference is which side of the marketplace it
 *  represents: a Merchant supplies orders, a LogisticsCompany supplies
 *  riders. Its own portal (logistics-portal.ts) is the same "distinct
 *  auth face" pattern as merchant-portal.ts. */
model LogisticsCompany {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  phone      String?
  email      String?
  active     Boolean  @default(true)
  /** Same application-review lifecycle as `Merchant.applicationStatus` —
   *  see its doc comment. Defaults `approved` for the same reason: a
   *  staff-created company (`POST /api/logistics-companies`) never went
   *  through a review step, and neither did any company that existed
   *  before this field. */
  applicationStatus ApplicationStatus @default(approved)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?             @relation("logisticsApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff  LogisticsCompanyStaff[]
  riders Rider[]
  messages PlatformMessage[]

  @@unique([businessId, slug])
}

/** Shared application-review lifecycle for a merchant or logistics-company
 *  self-signup (spec: "Platform Admin can approve/reject/disable/
 *  reactivate/inspect merchant applications") — see the doc comment on
 *  `Merchant.applicationStatus` for the full rationale. */
enum ApplicationStatus {
  pending
  approved
  rejected
}

model LogisticsCompanyStaff {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logisticsCompanyId String
  logisticsCompany   LogisticsCompany @relation(fields: [logisticsCompanyId], references: [id], onDelete: Cascade)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, logisticsCompanyId])
  @@index([logisticsCompanyId])
}

/** Spec: "Platform Admin controls whether a rider is: freelancer/
 *  platform-approved and eligible for marketplace work; attached only to
 *  one merchant; attached to one logistics/bearer company; approved for
 *  multiple businesses; disabled/blocked." `freelance` (the default,
 *  applied to every rider that existed before this) is unrestricted —
 *  every existing rider's real-world eligibility is completely unchanged.
 *  `merchant`/`logistics` restrict which jobs eligibleRiders() (offers.ts)
 *  will ever offer this rider — see that function's own doc comment for
 *  the exact rule, including the `platformStatus: approved` override. */
enum RiderAttachment {
  freelance
  merchant
  logistics
}

/**
 * Non-job-scoped direct messaging (spec: "secure messaging with a strict
 * authorization matrix... admin-to-anyone, logistics<->riders") —
 * deliberately a separate model from `DeliveryMessage`, which is always
 * tied to exactly one delivery. A `PlatformMessage` thread is identified
 * by its two fixed parties, same "no separate Conversation row, the
 * message's own columns are the identity" convention `DeliveryMessage`
 * already uses:
 *  - `owner_user`: the platform owner(s) (there may be more than one — this
 *    is a shared team inbox, not a specific owner's personal DM box) and
 *    one specific `targetUser` — any User on the platform (staff, a
 *    merchant/logistics portal-only account, or a rider's own login),
 *    covering "admin-to-anyone".
 *  - `logistics_rider`: one `LogisticsCompany` and one `Rider` — but only
 *    while that rider is actually attached to that company
 *    (Rider.attachedLogisticsCompanyId); the attachment relationship
 *    itself is the authorization, checked at send/read time, not stored
 *    redundantly here.
 */
enum PlatformMessageKind {
  owner_user
  logistics_rider
}

enum PlatformMessageSenderRole {
  owner
  user
  logistics
  rider
}

model PlatformMessage {
  id   String              @id @default(cuid())
  kind PlatformMessageKind

  /** owner_user only — the other party of the thread. */
  targetUserId String?
  targetUser   User?   @relation("platformMessageTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  /** logistics_rider only — both always set together. */
  logisticsCompanyId String?
  logisticsCompany   LogisticsCompany? @relation(fields: [logisticsCompanyId], references: [id], onDelete: Cascade)
  riderId            String?
  rider              Rider?            @relation(fields: [riderId], references: [id], onDelete: Cascade)

  senderRole PlatformMessageSenderRole
  /** User.id (owner or user sender) or Rider.id (rider sender) — whichever
   *  side actually sent this one message. Null only for a system-shaped
   *  future use; every real sender today has an id. */
  senderId   String?
  senderName String?
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, targetUserId])
  @@index([kind, logisticsCompanyId, riderId])
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum InviteTarget {
  staff
  merchant
}

/** A real, usable onboarding flow for adding someone to a business or
 *  merchant (spec: "Fix the current broken membership experience: if a
 *  person is invited/added to a business, they must get a real usable
 *  login/onboarding flow—secure invite link or password setup, role,
 *  pending/active/disabled status, resend invite, and revoke invite").
 *  No FK to User: the invited person may not have an account yet at all
 *  — accepting is what creates one (or attaches the membership to an
 *  existing account, same "one account, many memberships" rule as
 *  merchants.ts's own direct-grant path). `tokenHash` (never the raw
 *  token) is what accept-invite.ts looks up; the raw token only ever
 *  exists in the invite email and the URL, never stored. */
model Invite {
  id           String       @id @default(cuid())
  email        String
  name         String?
  target       InviteTarget
  /** businessId for target=staff, merchantId for target=merchant. */
  targetId     String
  /** Only meaningful for target=staff — the StaffMembership role to grant
   *  on accept. Always "viewer" in effect for target=merchant (a
   *  MerchantStaff row has no role field yet — see its own model). */
  role         Role?
  tokenHash    String       @unique
  status       InviteStatus @default(pending)
  invitedById  String
  invitedBy    User         @relation(fields: [invitedById], references: [id])
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  @@index([email, status])
  @@index([target, targetId])
}

enum RaterType {
  /** customer rates the courier */
  customer
  /** merchant rates the courier */
  merchant
  /** customer rates the merchant (the "second, separate rating" in spec) */
  customer_merchant
}

/** A delivery rating (spec: "Authorized customer and merchant may rate
 *  after a completed delivery... Prevent duplicate ratings..."). `raterType`
 *  encodes the full "who rates whom" relationship, so the existing
 *  `@@unique([jobId, raterType])` stays the duplicate-prevention mechanism:
 *    - customer        -> the courier (sets riderId)
 *    - merchant        -> the courier (sets riderId)
 *    - customer_merchant -> the merchant (sets merchantId)
 *  Exactly one of riderId/merchantId is non-null per row, enforced by the
 *  application (not a DB constraint). Adding the enum value and the nullable
 *  merchantId column is purely additive — safe for `prisma db push` against
 *  the already-deployed schema with no data migration. Deliberately no rater
 *  identity stored beyond `raterType`; the job itself already records who
 *  the customer/merchant were, and a moderator can trace via `jobId`. */
model Rating {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  riderId    String?
  rider      Rider?    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  raterType  RaterType
  score      Int
  comment    String?
  hidden     Boolean   @default(false)
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([jobId, raterType])
  @@index([riderId, hidden])
  @@index([merchantId, hidden])
}

model Product {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sku         String?
  photoUrl    String?
  category    String?
  /** Default/base price in minor units — a variant's own `priceOverride` wins when set. */
  price       Int
  currency    String   @default("JMD")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   ProductVariant[]
  orderItems JobItem[]

  @@index([merchantId, active])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String?
  color         String?
  sku           String?
  priceOverride Int?
  /** Null = not tracked (unlimited); a merchant not doing inventory leaves this unset. */
  inventoryQty  Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems JobItem[]

  @@index([productId])
}

// ---------- Customers ----------

model Customer {
  id               String    @id @default(cuid())
  /** Nullable only during the multi-tenancy migration's backfill window. A
   *  Customer row is one business's relationship with a person — the same
   *  phone number can be a separate Customer row at a different business.
   *  `identity` below (Stage 23) is the additive, global layer on top of
   *  this — it never replaces or is joined into ordinary per-business
   *  Customer reads/writes, only the cross-business identity/dashboard/
   *  duplicate-resolution paths touch it. */
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  email            String?
  addressText      String?
  landmark         String?
  point            Json?
  zoneId           String?
  zone             Zone?      @relation("customerZone", fields: [zoneId], references: [id], onDelete: SetNull)
  preferredChannel String?
  consentTracking  Boolean   @default(false)
  consentTrackingAt DateTime?
  consentMarketing Boolean   @default(false)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /** The global identity this business's customer resolves to, by exact
   *  normalized-phone match (Stage 23) — null only when the phone on file
   *  can't be confidently normalized (see lib/phone.ts). Assigning this is
   *  automatic and deterministic (same normalized phone = same identity);
   *  it is never a "merge" of two already-distinct identities — that's a
   *  separate, owner-only, audited action (see CustomerIdentity below). */
  identityId String?
  identity   CustomerIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  jobs    Job[]
  consents ConsentRecord[]

  @@unique([businessId, phone])
  @@index([identityId])
}

/** Whether a phone number's ownership has actually been proven, or is just
 *  what a business typed in. The only way to reach `verified` right now is
 *  the customer-dashboard's own phone-OTP flow (Stage 22) — there is no
 *  account/login system yet (that's Stage 25). */
enum CustomerIdentityStatus {
  provisional
  verified
}

/**
 * One real person across the whole platform (Stage 23, spec section 6) —
 * deliberately holds almost nothing: just enough to match a person's own
 * Customer rows across businesses together, never any of the per-business
 * PII itself (name/address/notes stay on Customer, business-scoped, as
 * always). `normalizedPhone` is the deterministic join key (exact match
 * only — see lib/phone.ts); `normalizedEmail` is a *candidate* signal for
 * duplicate-resolution, never auto-matched into the same identity on its
 * own (two different phones sharing an email become merge *candidates* for
 * an owner to confirm, not an automatic merge).
 */
model CustomerIdentity {
  id              String                 @id @default(cuid())
  normalizedPhone String                 @unique
  normalizedEmail String?
  status          CustomerIdentityStatus @default(provisional)
  verifiedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  customers      Customer[]
  mergedAliases  MergedPhoneAlias[]
  account        CustomerAccount?

  @@index([normalizedEmail])
}

/**
 * Optional email+password sign-in for a CustomerIdentity (Stage 25, spec
 * section 7) — "account-claim": a customer who already has real order
 * history under a phone-verified identity (Stage 22/23) can additionally
 * set up persistent credentials for it, so they don't need a fresh SMS
 * code every visit. The phone-OTP dashboard flow stays available
 * regardless — this is an additive upgrade, never a replacement, and
 * claiming one requires already holding a phone-verified session (see
 * customer-account.ts's claim route), so creating an account can never
 * itself be used to guess or take over somebody else's identity.
 */
model CustomerAccount {
  id              String           @id @default(cuid())
  identityId      String           @unique
  identity        CustomerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  email           String           @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/** Short-lived, single-use email codes (verify-email / password-reset) —
 *  the email-channel counterpart to CustomerAccessCode's phone-channel
 *  ones (Stage 22), same shape and same reasoning, kept as a separate
 *  model since the two channels' targets and purposes differ enough that
 *  forcing one shared table would need an awkward nullable-either-way
 *  design for no real benefit. */
model CustomerEmailCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

/** Once a CustomerIdentity is merged away (the owner-only, audited merge
 *  action), its own phone number would otherwise become unclaimed — a
 *  later booking using that same phone would silently create a brand-new
 *  identity and quietly undo the merge over time. This alias makes that
 *  phone permanently resolve to the identity it was merged into instead. */
model MergedPhoneAlias {
  id              String           @id @default(cuid())
  normalizedPhone String           @unique
  identityId      String
  identity        CustomerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  mergedAt        DateTime         @default(now())
}

// ---------- Jobs ----------

enum JobType {
  pickup
  delivery
  pickup_delivery
  return
}

enum JobStatus {
  new
  assigned
  accepted
  picked_up
  in_transit
  delivering
  delivered
  no_answer
  location_changed
  failed
  returned
  cancelled
}

enum Priority {
  normal
  express
  urgent
}

enum PaymentMethod {
  cod
  online
  card
  transfer
  /** Customer already paid the merchant in person; nothing to collect on delivery. */
  paid_at_store
  other
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum FailureReason {
  no_answer
  refused
  wrong_number
  address_not_found
  damaged
  absent
  other
}

/// Rider sub-progress inside the current status (rider-face detail; recorded as events).
enum RiderStage {
  none
  heading_to_pickup
  at_pickup
  heading_to_dropoff
}

model Job {
  id               String        @id @default(cuid())
  /** Nullable only during the multi-tenancy migration's backfill window —
   *  every job belongs to exactly one business once backfilled. This is the
   *  single source of truth for order/offer/message/COD/report isolation:
   *  everything else scopes off the job's businessId (directly or via it). */
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /** Which store/merchant client this order is for, when the order came
   *  through a merchant's own public order link — null for a job created
   *  directly with the courier business itself (e.g. the old single-store
   *  `/book` form, or a dispatcher-entered order with no merchant chosen). */
  merchantId       String?
  merchant         Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  jobNumber        String?
  externalRef      String?
  source           String        @default("manual")
  originalJobId    String?
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  type             JobType       @default(delivery)
  status           JobStatus     @default(new)
  priority         Priority      @default(normal)
  addressText        String?
  /** Geocoder's formatted match for addressText, if one was found — informational
   *  only; addressText (what staff/customer actually typed) is always the
   *  authoritative delivery address and is never overwritten by this. */
  addressProviderText String?
  landmark           String?
  point              Json?
  pickupPoint        Json?
  pickupAddressText  String?
  /** Same relationship to pickupAddressText as addressProviderText has to addressText. */
  pickupAddressProviderText String?
  pickupContact      String?
  itemSummary        String?
  quantity           Int?
  itemSize           String?
  itemColor          String?
  packageSize        String?
  instructions       String?
  stage              RiderStage @default(none)
  zoneId             String?
  zone               Zone?        @relation("jobZone", fields: [zoneId], references: [id], onDelete: SetNull)
  vehicle            VehicleType?
  fare             Int?
  fee              Int?
  subtotal         Int?
  currency         String        @default("JMD")
  paymentMethod    PaymentMethod @default(cod)
  paymentStatus    PaymentStatus @default(unpaid)
  pin              String?
  amountExpected   Int?
  amountCollected  Int?
  /** When `amountCollected` was last recorded — the ledger's "collection timestamp". */
  codCollectedAt     DateTime?
  /** Full COD reconciliation status — independent of `paymentStatus` (which only
   *  tracks whether enough was collected). Only meaningful for `paymentMethod: cod`
   *  jobs; stays at its default for everything else. */
  codStatus          CodStatus @default(pending_collection)
  /** Cash the rider has handed in to the office for this job — separate from
   *  `amountCollected` (what they took from the customer) so a shortage/overage
   *  between the two can be shown, not silently assumed equal. */
  codHandedInAmount  Int?
  codHandoverAt      DateTime?
  /** Rider's own note on the collection/handover (e.g. "customer paid exact,
   *  no change needed"). Accountant's note is separate — neither overwrites
   *  the other, and both are preserved even after approval. */
  codRiderNote       String?
  codAccountantNote  String?
  codApprovedById    String?
  codApprover        User?     @relation("codApprover", fields: [codApprovedById], references: [id], onDelete: SetNull)
  codApprovedAt      DateTime?
  /** Set once a dispute is raised, kept as the historical record after
   *  resolution — see CodDisputeType's own doc comment. */
  codDisputeType     CodDisputeType?
  /** Stage 38 (spec: "financial dispute/archival workflow") — housekeeping
   *  only, hides a settled entry from the day-to-day COD board (same
   *  "operational views only" rule as Job.deletedAt) once it's been
   *  `approved` for a while; never a delete, and reports/audit/the
   *  summary endpoint never filter it out. Archive-eligibility (30+ days
   *  since `codApprovedAt`) is computed from the date, not a stored flag —
   *  same convention as jobs-trash.ts's purge-eligibility check — but
   *  unlike that one-way purge, archiving here is always reversible. */
  codArchivedAt      DateTime?
  codArchivedById    String?
  codArchivedBy      User?     @relation("codArchiver", fields: [codArchivedById], references: [id], onDelete: SetNull)
  failureReason    FailureReason?
  failureNote      String?
  riderId          String?
  rider            Rider?        @relation(fields: [riderId], references: [id], onDelete: SetNull)
  routeSeq         Int?
  routeEta         DateTime?
  scheduledAt      DateTime?
  promisedAt       DateTime?
  completedAt      DateTime?
  /** Set once the merchant new-order notification email has actually been
   *  attempted for this job — an idempotency guard (a guarded `updateMany`
   *  sets this before sending), not a delivery confirmation. Null for a job
   *  with no merchant, or one created before this existed. */
  merchantNotifiedAt DateTime?
  /** Same idempotency-guard pattern as merchantNotifiedAt, but for the
   *  dispatch-side "a new order came in" alert — fires for every order,
   *  merchant-linked or not, unlike the merchant email above. */
  dispatchNotifiedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /** Soft-delete only (Stage 26, spec 8) — trash, never a real DELETE. Every
   *  child row below (CodEvent, JobEvent, Proof, etc.) keeps its
   *  `onDelete: Cascade` relation to this row, which is exactly why this
   *  row itself must never actually be removed: a hard delete would take
   *  the cash ledger and audit trail with it. Restorable for 30 days from
   *  `deletedAt`; past that, `jobs/trash.ts`'s purge-eligibility check
   *  (computed from the date, not a separate stored flag) makes restore
   *  refuse — but the row, and everything referencing it, stays exactly
   *  as it was. Reports/COD-reconciliation/audit views never filter this
   *  out; only the ordinary operational views (Jobs list, ops board,
   *  offers, route queue) do. */
  deletedAt        DateTime?
  deletedById      String?
  deleteReason     String?

  assignments RiderAssignment[]
  events    JobEvent[]
  proofs    Proof[]
  link      TrackingLink?
  alerts    SosAlert[]
  offers    JobOffer[]
  stops     RouteStop[]
  payoutLines PayoutLine[]
  codEvents CodEvent[]
  messages DeliveryMessage[]
  addressChangeRequests AddressChangeRequest[]
  items JobItem[]
  settlementLines SettlementLine[]
  ratings Rating[]

  @@unique([businessId, jobNumber])
  @@unique([businessId, externalRef])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, merchantId])
}

/** One line of a (possibly multi-item) order. Every job gets at least one of
 *  these once created through the item-aware paths (the public multi-item
 *  order form, or the updated staff order form) — `Job.itemSummary`/
 *  `quantity`/`itemSize`/`itemColor` are kept in sync as a derived, flattened
 *  summary purely so every screen that already reads those fields directly
 *  keeps working unchanged; `JobItem` rows are the real source of truth
 *  going forward. `productId`/`productVariantId` are null for a merchant
 *  without a catalog yet — free-text `name`/`size`/`color` always work. */
model JobItem {
  id               String          @id @default(cuid())
  jobId            String
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  name             String
  size             String?
  color            String?
  quantity         Int             @default(1)
  /** Minor units. For a catalog item this is the product/variant price at
   *  order time (snapshotted — a later price change must never reprice an
   *  old order); for a free-text item it's whatever the customer/staff typed. */
  unitPrice        Int
  currency         String          @default("JMD")
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([jobId])
}

enum CodStatus {
  pending_collection
  collected
  handed_in
  disputed
  approved
}

/** Stage 38: an explicit dispute category, set when a dispute is raised —
 *  not merely inferred from `codHandedInAmount - amountCollected`'s sign,
 *  since a dispute can be raised as soon as `collected` (spec: "before any
 *  hand-in"), when there's no handed-in amount yet to compare at all.
 *  Preserved after resolution (approval) as the historical record of what
 *  kind of dispute this was — never cleared. */
enum CodDisputeType {
  shortage
  overage
  other
}

/**
 * Append-only audit trail for a job's COD reconciliation — every rider
 * collection/handover and every accountant approve/dispute becomes one row
 * here, in addition to updating the current state on Job itself. Rows are
 * never edited or deleted, so "approved entries can't be silently
 * overwritten" always has a paper trail even if the current fields on Job
 * are later changed by a legitimate re-open (e.g. approved -> disputed).
 */
model CodEvent {
  id        String     @id @default(cuid())
  jobId     String
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  from      CodStatus?
  to        CodStatus
  actorType String
  actorId   String?
  actorName String?
  note      String?
  meta      Json?
  at        DateTime   @default(now())

  @@index([jobId, at])
}

enum OfferStatus {
  open
  accepted
  declined
  withdrawn
  expired
}

/// A time-bound invitation to a rider. Direct assignment remains on Job;
/// offers are an auditable, race-safe way to let an eligible rider claim it.
model JobOffer {
  id        String      @id @default(cuid())
  /** Denormalized from job.businessId — kept directly on the offer too so
   *  "offers for my business" never needs a join, and so a rider's own
   *  offer list can be filtered to businesses they're an active member of
   *  without touching Job at all. Nullable only during the migration's
   *  backfill window. */
  businessId String
  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  riderId   String
  rider     Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)
  status    OfferStatus @default(open)
  expiresAt DateTime
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([riderId, status, expiresAt])
  @@index([jobId, status])
  @@index([businessId, status])
}

enum AssignmentStatus {
  assigned
  accepted
  declined
  reassigned
}

model RiderAssignment {
  id        String           @id @default(cuid())
  jobId     String
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  riderId   String
  rider     Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  status    AssignmentStatus @default(assigned)
  reason    String?
  oldRiderId String?
  at        DateTime         @default(now())

  @@index([jobId])
  @@index([riderId, at])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  from      String?
  to        String
  actorType String   @default("system")
  actorId   String?
  actorName String?
  note      String?
  meta      Json?
  at        DateTime @default(now())

  @@index([jobId, at])
}

// ---------- Routing ----------

enum RouteStatus {
  planned
  active
  abandoned
  completed
}

model Route {
  id             String        @id @default(cuid())
  riderId        String
  rider          Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  date           DateTime
  status         RouteStatus   @default(planned)
  totalDistanceM Int?
  totalDurationS Int?
  provider       String?
  createdAt      DateTime      @default(now())

  stops RouteStop[]

  @@index([riderId, date])
}

model RouteStop {
  id          String   @id @default(cuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seq         Int
  point       Json
  customerName String?
  addressText String?
  etaAt       DateTime?

  @@index([routeId, seq])
}

// ---------- Live location ----------

model RiderLocation {
  id            String   @id @default(cuid())
  riderId       String
  rider         Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  point         Json
  heading       Float?
  speedKph      Float?
  battery       Int?
  trackingState String   @default("active")
  clientSeq     Int
  at            DateTime @default(now())

  @@index([riderId, at])
}

// ---------- Evidence ----------

enum ProofKind {
  pickup_photo
  delivery_photo
  receipt_photo
  signature
  package_photo
}

model Proof {
  id       String     @id @default(cuid())
  jobId    String
  job      Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind     ProofKind
  filename String
  url      String
  hash     String
  size     Int
  point    Json?
  at       DateTime   @default(now())

  @@index([jobId])
}

// ---------- Customer tracking link ----------

model TrackingLink {
  id           String    @id @default(cuid())
  jobId        String    @unique
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  token        String    @unique
  expiresAt    DateTime
  revoked      Boolean   @default(false)
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

// ---------- Delivery messaging (spec 5G) ----------

enum MessageSenderRole {
  customer
  rider
  dispatcher
  system
}

/** One chat message, always tied to exactly one delivery. Text-only,
 *  never carries the delivery PIN or internal notes (the API never
 *  constructs a message body from those fields — messages are always
 *  either user-typed text or one of a small set of fixed system
 *  announcements, e.g. an address-change decision). */
/** Which pairwise conversation a message belongs to (Stage 24, spec
 *  section 5) — replacing the old single shared thread. Null means
 *  "legacy" (every message that existed before this stage, when there
 *  really was only one merged thread — see the backfill script's own
 *  comment for why those are kept as a read-only archive rather than
 *  guessed into one of the three new conversations) or a system-level
 *  announcement (an address-change decision) that's relevant to every
 *  conversation on the job, not just one pair. */
enum ConversationKind {
  customer_dispatch
  customer_rider
  rider_dispatch
}

model DeliveryMessage {
  id               String            @id @default(cuid())
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** Null = legacy (pre-Stage-24) or a system announcement — see
   *  ConversationKind's own doc comment. */
  conversationKind ConversationKind?
  senderRole       MessageSenderRole
  /** User.id for dispatcher, Rider.id for rider, null for customer/system */
  senderId         String?
  senderName       String?
  body             String
  /** A single recipient-side receipt pair, not three separate role flags —
   *  every conversation now has exactly two sides, so "the other side"
   *  is unambiguous. `deliveredAt`: for a rider/staff recipient with a
   *  live socket connected at send time, set immediately (a genuine
   *  live-delivery signal); otherwise (customers are poll-only — this
   *  app has no live channel for them — or the recipient wasn't
   *  connected) set on their next fetch, same as `readAt`. `readAt`: set
   *  when the recipient's client actually loads the conversation. For a
   *  poll-only customer recipient these two will often land together —
   *  an honest consequence of not having a push/ack channel to them, not
   *  faked to look more granular than it is. */
  deliveredAt      DateTime?
  readAt           DateTime?
  /** Client-generated idempotency token — retrying the same compose
   *  action (e.g. after a network blip) reuses it, so the server can
   *  recognize the retry and return the already-sent message instead of
   *  creating a duplicate. Unique per job+conversation, not globally
   *  (independent conversations may coincidentally generate the same
   *  client-side random token). */
  clientToken      String?
  createdAt        DateTime          @default(now())

  @@index([jobId, conversationKind, createdAt])
  @@unique([jobId, conversationKind, clientToken])
}

enum AddressChangeStatus {
  pending
  approved
  declined
}

/** A customer/rider proposing a new destination in chat is never applied
 *  automatically — this row is the explicit review queue dispatch acts on;
 *  only `approve()` (see delivery-messages.ts) ever writes to Job.addressText,
 *  and it does so alongside a JobEvent, so the change is fully audited. */
model AddressChangeRequest {
  id                   String              @id @default(cuid())
  jobId                String
  job                  Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedByRole      MessageSenderRole
  proposedAddressText  String
  note                 String?
  status               AddressChangeStatus @default(pending)
  reviewedById         String?
  reviewedBy           User?               @relation("addressChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())

  @@index([jobId, status])
}

// ---------- Consent ----------

enum ConsentScope {
  live_tracking
  marketing
  contacts
}

model ConsentRecord {
  id         String       @id @default(cuid())
  subjectType String     @default("customer")
  subjectId  String
  customer   Customer?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scope      ConsentScope
  granted    Boolean
  channel    String?
  at         DateTime     @default(now())

  @@index([subjectType, subjectId])
}

// ---------- Notifications (outbox) ----------

enum NotificationChannel {
  whatsapp
  sms
  push
  in_app
}

/** See the matching comment in packages/contracts/src/enums.ts — `sent` means
 *  the provider accepted it, not that it was confirmed delivered. */
enum NotificationStatus {
  queued
  sending
  sent
  delivered
  failed
  suppressed
}

model OutboxMessage {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  to          String
  template    String
  params      Json
  jobId       String?
  /** The business a job-linked message belongs to (derived from the job at
   *  enqueue time) — required for staff to ever see it in their notification
   *  list (see notify.ts's list()/retry(), which filter on this). Null for
   *  platform-level messages tied to no single business, such as the
   *  cross-business customer-dashboard access code (Stage 22) — those are
   *  never shown to any business's staff. Nullable rather than backfilled to
   *  a placeholder, since "no business" is a real, distinct case, not a gap
   *  in migrated data. */
  businessId  String?
  status      NotificationStatus  @default(queued)
  provider    String
  providerRef String?
  error       String?
  attempts    Int                 @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  costMinor   Int?
  costCurrency String?
  createdAt   DateTime            @default(now())

  @@index([status, scheduledAt])
  @@index([businessId, createdAt])
}

/** A short-lived, single-use code proving ownership of a phone number, for
 *  the cross-business customer package dashboard (Stage 22, spec 4) — not a
 *  password or an account, just phone verification for a read-only session.
 *  `phone` is normalized by the provisional lib/phone.ts helper (Jamaica-
 *  default); Stage 23 replaces that normalizer with a proper library without
 *  changing this model. */
model CustomerAccessCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ---------- Money: reconciliation & payouts ----------

enum ReconStatus {
  open
  matched
  shortage
  overage
  investigating
  resolved
}

model ReconDaily {
  id           String       @id @default(cuid())
  riderId      String
  rider        Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  date         String
  expected     Int
  collected    Int
  declared     Int?
  variance     Int
  currency     String       @default("JMD")
  status       ReconStatus  @default(open)
  note         String?
  resolvedById String?
  resolvedBy   User?        @relation("reconResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  @@unique([riderId, date])
}

enum PayoutStatus {
  draft
  approved
  paid
}

enum PayoutMethod {
  cash
  bank_transfer
  wire
  wipay
}

model Payout {
  id           String        @id @default(cuid())
  riderId      String
  rider        Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  base         Int
  perDelivery  Int
  codCollected Int
  deductions   Int
  net          Int
  currency     String        @default("JMD")
  method       PayoutMethod?
  status       PayoutStatus  @default(draft)
  reference    String?
  note         String?
  approvedById String?
  approvedBy   User?         @relation("payoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  lines PayoutLine[]

  @@index([riderId, periodStart])
}

model PayoutLine {
  id          String  @id @default(cuid())
  payoutId    String
  payout      Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  description String
  amount      Int
  currency    String  @default("JMD")
}

enum SettlementType {
  full
  partial
}

/**
 * A rider handing COD cash they're holding for one merchant over to the
 * office, recorded as its own ledger entry — distinct from `Payout` (which
 * is the business paying the RIDER their own earnings; this is the RIDER
 * paying the BUSINESS money they collected on a merchant's behalf) and from
 * the existing per-job `CodEvent` hand-in/approve trail (which this doesn't
 * replace — a settlement batches several already-handed-in jobs into one
 * "the office actually has this now" record, for one rider and one merchant
 * at a time; the underlying jobs keep their own individual CodEvent history
 * either way). Never deletes/rewrites a prior settlement — a correction is
 * a new settlement (possibly negative in spirit, but represented as its own
 * note+lines), same ledger-immutability rule as everywhere else in this app.
 */
model Settlement {
  id           String         @id @default(cuid())
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  riderId      String
  rider        Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  /** Null = settling the rider's non-merchant (direct/in-house) cash. */
  merchantId   String?
  merchant     Merchant?      @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  amount       Int
  currency     String         @default("JMD")
  type         SettlementType @default(full)
  receivedById String
  receivedBy   User           @relation("settlementReceiver", fields: [receivedById], references: [id])
  reference    String?
  note         String?
  createdAt    DateTime       @default(now())

  lines SettlementLine[]

  @@index([businessId, riderId])
  @@index([businessId, merchantId])
}

/** Which specific jobs a settlement's cash actually covers — so "outstanding"
 *  is always a real computation (sum of handed-in jobs minus settled jobs),
 *  never a mutable running total that a correction could silently corrupt. */
model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount       Int

  @@index([settlementId])
  @@index([jobId])
}

// ---------- Safety ----------

enum SosStatus {
  active
  acknowledged
  resolved
}

model SosAlert {
  id              String     @id @default(cuid())
  riderId         String
  rider           Rider      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  point           Json?
  note            String?
  status          SosStatus  @default(active)
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  at              DateTime   @default(now())

  @@index([status, at])
}

// ---------- Auditing & sync ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       String?
  action     String
  entityType String
  entityId   String?
  /** Derived automatically (see audit.ts's record()) from the entity being
   *  logged, when that entity has one — job/customer/offer events do,
   *  rider/user events genuinely don't (riders and users are global; a
   *  rider being created or a staff member logging in isn't "business A's"
   *  event any more than another business's). Null here is a real,
   *  correct case, not a migration gap. Found and fixed in Stage 23:
   *  GET /api/audit had no business filter at all — any staff member at
   *  any business could read every other business's entire audit trail. */
  businessId String?
  ip         String?
  meta       Json?
  at         DateTime @default(now())

  @@index([at])
  @@index([entityType, entityId])
  @@index([businessId, at])
}

model ExternalOrder {
  id         String   @id @default(cuid())
  source     String   @default("woocommerce")
  externalId String
  status     String?
  currency   String?
  placedAt   DateTime?
  syncedAt   DateTime @default(now())
  data       Json
  jobCreated Boolean  @default(false)

  @@unique([source, externalId])
}

// ---------- Settings ----------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
