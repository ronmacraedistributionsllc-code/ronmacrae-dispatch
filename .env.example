# ============================================================
# Ronmacrae Dispatch - environment template
# Copy to .env and fill in values. NEVER commit real secrets.
# Every key is optional for local preview: the system runs a
# fully functional demo without any external credentials.
# ============================================================

# --- Core ---------------------------------------------------
# public origin used in links / CORS
APP_ORIGIN=http://localhost:5173
# secret used to sign session JWTs (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string
# log level: debug|info|warn|error
LOG_LEVEL=info

# --- Database -----------------------------------------------
# Production (DigitalOcean managed Postgres): postgresql://user:pass@host:5432/rmd?schema=public
# Local zero-service preview: set DEV_DB=1 (uses SQLite file, no server needed)
DEV_DB=1
DATABASE_URL=postgresql://rmd:change-me@localhost:5432/rondispatch

# --- Queues -------------------------------------------------
# memory = in-process (dev/preview, single process)
# bullmq  = requires REDIS_URL (production)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- Maps / routing ------------------------------------------
# Leave GOOGLE_MAPS_API_KEY empty to use the keyless OpenStreetMap fallback.
GOOGLE_MAPS_API_KEY=
# Optional: JAMNAV (UWI Mona) landmark/settlement geocoding for Jamaica-first fallback
JAMNAV_API_KEY=
JAMNAV_ENABLED=

# --- Notifications -------------------------------------------
# Leave provider=memory to log notifications to the outbox/UI without sending.
# Set provider=twilio and fill the keys to actually send WhatsApp/SMS.
NOTIFICATION_PROVIDER=memory
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_SMS_FROM=+10000000000

# --- WooCommerce (ronmacraedistributions.com) ----------------
# Create keys under WooCommerce > Settings > Advanced > REST API (Read+Write)
WOO_API_URL=https://ronmacraedistributions.com/wp-json/wc/v3
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# polling cadence for the pull-based order sync (ms)
WOO_POLL_INTERVAL_MS=120000
# currency of the Woo store; if empty it is auto-detected from Woo settings on first sync
WOO_CURRENCY=

# --- Business / currency --------------------------------------
# operational currency code (ISO 4217): JMD default, USD supported
OPERATIONAL_CURRENCY=JMD
# optional FX rate 1 USD -> JMD (for dual-currency display/conversion)
USD_TO_JMD_RATE=155

# --- Delivery -------------------------------------------------
# delivery PIN length
PIN_LENGTH=4
# customer tracking link lifetime after creation (hours)
TRACKING_LINK_TTL_HOURS=72
# stop broadcasting location updates after this many hours post-completion
LOCATION_RETENTION_HOURS=24

# --- Web -------------------------------------------------------
# where the web build is served from by the API in preview mode (empty = disabled)
WEB_DIST=
# bearer upload limit
MAX_UPLOAD_BYTES=8388608
